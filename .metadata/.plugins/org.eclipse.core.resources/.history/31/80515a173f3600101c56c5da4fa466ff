package com.mediLabo.patientApi.service;

import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;

import com.mediLabo.patientApi.dto.NoteDto;

@FeignClient(url = "http://localhost:5002", value = "noteApi")
public interface ApiClient {
	@GetMapping("api/notes/{patientNom}")
	NoteDto getNoteDto(@PathVariable  String patientNom);
}
