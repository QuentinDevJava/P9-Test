	@GetMapping("/patients")
	public String listPatients(Model model) {
		Patient[] patients = restTemplate.getForObject(apiUrl, Patient[].class);
		model.addAttribute("patients", Arrays.asList(patients));
		return "patients";
	}

	@GetMapping("/patients/{id}")
	public String viewPatient(@PathVariable int id, Model model) {
		Patient patient = restTemplate.getForObject(apiUrl + "/" + id, Patient.class);
		model.addAttribute("patient", patient);
		return "patient-detail";
	}
}