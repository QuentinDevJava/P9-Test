<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Notes du patient</title>
</head>
<body>
    <h1>Notes du patient</h1>

    <div th:if="${patient}">
        <h2 th:text="'Nom : ' + ${patient.nom} + ' ' + ${patient.prenom}">Nom complet</h2>

        <h3>Notes :</h3>
        <ul>
            <li th:each="note : ${patient.notes}">
                <span th:text="${note.note}">Note</span>
                <a th:href="@{'/patients/notes/edit/' + ${note.id}}">Modifier</a>
            </li>
        </ul>

        <p>
            <a th:href="@{'/patients/notes/add/' + ${patient.nom}}"> Ajouter une nouvelle note</a>
        </p>

        <p><a href="/patients"> Retour à la liste des patients</a></p>
    </div>
</body>
</html>