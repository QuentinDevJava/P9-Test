<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Notes du patient</title>
</head>
<body>
    <h1>Notes du patient</h1>
    <h2 th:text="'Nom du patient : ' + ${patientNom}">Nom</h2>

    <h3>Liste des notes :</h3>
    <ul>
        <li th:each="note : ${notes}" th:text="${note}">Note ici</li>
    </ul>

    <a href="/patients">← Retour à la liste des patients</a>
</body>
</html>
