server:
  port: 5005  # Port du gateway

spring:
  application:
    name: GATEWAY

  cloud:
    discovery:
      enabled: true
    gateway:
      routes:
        - id: PATIENTAPI
          uri: lb://PATIENTAPI
          predicates:
            - Path=/api/patients/**
        - id: NOTEAPI
          uri: lb://NOTEAPI
          predicates:
            - Path=/api/notes/**

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
