<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Mettre à jour un patient</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-5">

    <h1 class="mb-4">Mettre à jour un patient</h1>

    <form th:action="@{'/patients/update/' + ${patient.id}}" th:object="${patient}" method="post" class="row g-3">
        <div class="col-md-6">
            <label for="nom" class="form-label">Nom :</label>
            <input type="text" th:field="*{nom}" class="form-control" id="nom" required />
        </div>

        <div class="col-md-6">
            <label for="prenom" class="form-label">Prénom :</label>
            <input type="text" th:field="*{prenom}" class="form-control" id="prenom" required />
        </div>

        <div class="col-md-6">
            <label for="date" class="form-label">Date de naissance :</label>
            <input type="date" th:field="*{date}" class="form-control" id="date" required />
        </div>

        <div class="col-md-6">
            <label for="genre" class="form-label">Genre :</label>
            <select th:field="*{genre}" class="form-select" id="genre" required>
                <option value="M">Masculin</option>
                <option value="F">Féminin</option>
            </select>
        </div>

        <div class="col-md-6">
            <label for="adresse" class="form-label">Adresse :</label>
            <input type="text" th:field="*{adresse}" class="form-control" id="adresse" />
        </div>

        <div class="col-md-6">
            <label for="telephone" class="form-label">Téléphone :</label>
            <input type="text" th:field="*{telephone}" class="form-control" id="telephone" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Mettre à jour</button>
            <a href="/patients" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </form>

</body>
</html>
