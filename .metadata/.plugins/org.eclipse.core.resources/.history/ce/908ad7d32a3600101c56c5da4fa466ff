//				.telephone(patient.getTelephone()).note(apiResponseDto.getNoteDto().getNote()).build();
//	}

	public Patient toEntity(PatientDto dto) {
		return Patient.builder().nom(dto.getNom()).prenom(dto.getPrenom()).dateAnniversaire(dto.getDateAnniversaire())
				.genre(dto.getGenre()).adresse(dto.getAdresse()).telephone(dto.getTelephone()).build();
	}
}
