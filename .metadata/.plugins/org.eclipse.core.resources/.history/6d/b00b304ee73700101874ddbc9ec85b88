spring:
  application:
    name: PATIENTAPI

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/medilaboDB
    username: root
    password:

  jpa:
    hibernate:
      ddl-auto: create-drop
    show-sql: false
    open-in-view: true

  cloud:
    config:
     enabled: false

    discovery:
      enabled: true
eureka: 
 client: 
  service-url: 
   defaultZone: http://localhost:8761/eureka/ 

server:
  port: 5000 # Port de patientApi

management:
  endpoints:
    web:
      exposure:
        include: health
