spring:
  application:
    name: NOTEAPI

  data:
    mongodb:
      uri: mongodb://localhost:27017/dbNote

  cloud:
    config:
      enabled: false
    discovery:
      enabled: true
eureka: 
 client: 
  service-url: 
   defaultZone: http://localhost:8761/eureka/ 

 instance:
   prefer-ip-address: true
server:
  port: 5002

management:
  endpoints:
    web:
      exposure:
        include: health
