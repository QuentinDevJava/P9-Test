server:
  port: 5005  # Port du gateway

spring:
  application:
    name: gatewayApi

  cloud:
    discovery:
      enabled: true
    gateway:
      routes:
        - id: patientApi
          uri: lb://patientApi
          predicates:
            - Path=/api/patients/**
        - id: noteApi
          uri: lb://noteApi
          predicates:
            - Path=/api/notes/**
management:
  endpoints:
    web:
      exposure:
        include: '*'
  endpoint:
    gateway:
      access: unrestricted
eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
   prefer-ip-address: true