package com.mediLabo.mapper;

import org.springframework.stereotype.Component;
import com.mediLabo.dto.PatientDto;
import com.mediLabo.entities.Patient;

@Component
public class PatientMapper {

	public PatientDto toDto(Patient patient) {
		return PatientDto.builder().id(patient.getId()).nom(patient.getNom()).prenom(patient.getPrenom())
				.date(patient.getDate()).genre(patient.getGenre()).adresse(patient.getAdresse())
				.telephone(patient.getTelephone()).build();
	}

	public Patient toEntity(PatientDto dto) {
		return Patient.builder().nom(dto.getNom()).prenom(dto.getPrenom()).date(dto.getDate()).genre(dto.getGenre())
				.adresse(dto.getAdresse()).telephone(dto.getTelephone()).build();
	}
}
