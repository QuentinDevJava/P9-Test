server:
  port: 5005  # Port du gateway

spring:
  application:
    name: gatewayApi

  cloud:
    config:
      enabled: false
    discovery:
      enabled: true
    gateway:

      discovery:
        locator:
          enabled: true
management:
  endpoints:
    web:
      exposure:
        include: '*'
  endpoint:
    gateway:
      access: unrestricted
eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
   prefer-ip-address: true