package com.mediLabo.noteApi.mapper;

import org.springframework.stereotype.Component;

import com.mediLabo.noteApi.dto.NoteDto;
import com.mediLabo.noteApi.entities.Note;
import com.mediLabo.patientApi.dto.PatientDto;
import com.mediLabo.patientApi.entities.Patient;

@Component
public class NoteMapper {

	public NoteDto toDto(Note note, NoteDto noteDto) {
		return noteDto.builder().id(note.getId()).note(note.getNote()).fkPatientNom(note.getFkPatientNom()).build();
	}
