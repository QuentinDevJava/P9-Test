package com.mediLabo.noteApi.mapper;

import org.springframework.stereotype.Component;

import com.mediLabo.noteApi.dto.NoteDto;
import com.mediLabo.noteApi.entities.Note;
import com.mediLabo.noteApi.service.NoteService;

@Component
public class NoteMapper {

	private NoteService noteService;
	
	public NoteDto toDto(Note note) {
		return NoteDto.builder().id(note.getId()).fkPatientNom(note.getFkPatientNom()).notes(note.getNote()).build();
	}

	public Note toEntity(NoteDto noteDto) {
		return Note.builder().id(noteDto.getId()).fkPatientNom(noteDto.getFkPatientNom()).note(noteDto.getNote())
				.build();
	}
}
