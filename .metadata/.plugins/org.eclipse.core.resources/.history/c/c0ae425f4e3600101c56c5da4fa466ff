<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Notes du patient</title>
</head>
<body>
    <h1>Notes du patient</h1>
    <div>
        <h2 th:text="'Nom : ' + ${patient.nom}"></h2>
        <h2 th:text="'Prenom : ' + ${patient.prenom}"></h2>

        <h3>Notes :</h3>
		<table border="1">
		    <thead>
		        <tr>
		            <th>ID</th>
		            <th>Contenu de la note</th>
		            <th>Actions</th>
		        </tr>
		    </thead>
		    <tbody>
		        <tr th:each="note : ${patient.notes}">
		            <td th:text="${note.note}">Contenu</td>
		            <td>
		                <a th:href="@{'/patients/notes/edit/' + ${note.id}}">✏️ Modifier</a>
		            </td>
		        </tr>
		    </tbody>
		</table>

		<br>
		<p>
		    <a th:href="@{'/patients/notes/add/' + ${patient.nom}}">➕ Ajouter une nouvelle note</a>
		</p>
		<p>
		    <a href="/patients">← Retour à la liste des patients</a>
		</p>
    </div>
</body>
</html>