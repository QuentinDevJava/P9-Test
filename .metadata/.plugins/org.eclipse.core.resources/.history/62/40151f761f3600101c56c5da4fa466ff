spring:
  application:
    name: noteApi

  datasource:
    url: jdbc:h2:mem:dbNote
    username: sa
    password:

  h2:
    console:
      enabled: true
      path: /h2

  jpa:
    show-sql: true
    hibernate:
      ddl-auto: create
    open-in-view: true

  cloud:
   config:
    enabled: false

   discovery:
    enabled: false

server:
  port: 5000 # Port de noteApi

management: 
  endpoints: 
    web: 
      exposure: 
        include: 'health'