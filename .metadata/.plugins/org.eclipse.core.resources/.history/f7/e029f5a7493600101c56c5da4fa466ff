	@GetMapping("/notes/{nom}")
	public String afficherNotesPatient(@PathVariable String nom, Model model) {
		// Appel du microservice pour récupérer tous les patients
		Patient[] patients = restTemplate.getForObject(patientApiUrl, Patient[].class);

		// Chercher le patient correspondant au nom
		Optional<Patient> patientOpt = Arrays.stream(patients).filter(p -> p.getNom().equalsIgnoreCase(nom))
				.findFirst();

		if (patientOpt.isEmpty()) {
			model.addAttribute("error", "Patient non trouvé.");
			return "notes-patient";
		}

		Patient patient = patientOpt.get();
		model.addAttribute("patientNom", patient.getNom());
		model.addAttribute("notes", patient.getNotes());

		return "notes-patient";
	}
}