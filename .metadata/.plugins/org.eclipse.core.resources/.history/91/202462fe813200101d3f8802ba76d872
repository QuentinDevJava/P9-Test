<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Mettre à jour un patient</title>
</head>
<body>
    <h1>Mettre à jour un patient</h1>
    <form th:action="@{'/patients/update/' + ${patient.id}}" th:object="${patient}" method="post">
        <p>Nom : <input type="text" th:field="*{nom}" /></p>
        <p>Prénom : <input type="text" th:field="*{prenom}" /></p>
		<!-- Champ principal de date -->
		<p>Date de naissance (th:field) : 
		    <input type="date" th:field="*{date}" />
		</p>

		<!-- Champs de test avec différents formats injectés dans un input de type date -->
		<p>Date test format manuel (yyyy-MM-dd) : 
		    <input type="date" th:value="${#temporals.format(patient.date, 'yyyy-MM-dd')}" />
		</p>

		<p>Date test format manuel (dd-MM-yyyy) [⚠️ HTML5 invalide] : 
		    <input type="date" th:value="${#temporals.format(patient.date, 'dd-MM-yyyy')}" />
		</p>

		<p>Date test format manuel (MM/dd/yyyy) [⚠️ HTML5 invalide] : 
		    <input type="date" th:value="${#temporals.format(patient.date, 'MM/dd/yyyy')}" />
		</p>

		<!-- Format brut pour contrôle -->
		<p>Date brute rendue : 
		    <input type="date" th:value="${patient.date}" />
		</p>

        <p>Genre : 
            <select th:field="*{genre}">
                <option value="M">Masculin</option>
                <option value="F">Féminin</option>
            </select>
        </p>
        <p>Adresse : <input type="text" th:field="*{adresse}" /></p>
        <p>Téléphone : <input type="text" th:field="*{telephone}" /></p>
        <p><button type="submit">Mettre à jour</button></p>
    </form>
    <a href="/patients">Retour à la liste</a>
</body>
</html>
